# Browser-facing port for Ports itself.
PORTS_HTTP_PORT=5000

# Optional hostname/IP used when creating service links. By default, Ports uses
# the same hostname you used to open the dashboard.
LINK_HOST=

# Comma-separated single ports or ranges.
PORT_RANGES=1000-1999,2000-2999,3000-3999,4000-4999,5000-9999,10000-65535
RESERVED_PORTS=22,80,443
HTTPS_PORTS=443,8443,9443

AVAILABLE_COUNT=20
SHOW_ALL_CONTAINERS=true
CHECK_HOST_BIND=false
